{
  "name": "zelton-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ZELTON (SonicForge Studio) - Complete Monorepo with Frontend DAW & Backend Server",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:all": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=frontend",
    "build:all": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "test": "npm run test --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
